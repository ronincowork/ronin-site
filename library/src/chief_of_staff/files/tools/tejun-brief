#!/usr/bin/env bash
# tejun-brief — every teammate's work record, read for the morning brief. Implements `team-brief`.
#
# Usage: tejun-brief [team]     no argument = the team this session is on
# Prints, per member: name · 人 · dial · objective · the rung being worked (or "no record").
# Reads only. A member dialled 👤 user is reported as unreadable, not skipped in silence.
# Exit 2 = no team named and this session is on none (or several — name one), 3 = no such team.
set -u
team=${1:-}
if [ -z "$team" ]; then
  tags=$(tmux display-message -p '#{@ronin-tags}' 2>/dev/null || true)
  tags=${tags//[[:space:]]/}
  case $tags in
    "") echo "NO-TEAM: this session is on no team; name one: tejun-brief <team>" >&2; exit 2 ;;
    *,*) echo "WHICH-TEAM: this session is on several ($tags); name one: tejun-brief <team>" >&2; exit 2 ;;
  esac
  team=$tags
fi
roster=$(tejun-team "$team" 2>/dev/null) || { echo "NO-TEAM: no such team '$team'" >&2; exit 3; }
printf 'BRIEF %s — %s\n' "$team" "$(date +%F)"
while read -r name dial lead; do
  [ -n "$name" ] || continue
  mark=$([ "$lead" = "人" ] && echo "人" || echo "  ")
  if [ "$dial" = "user" ]; then
    printf '%s %-22s  (owner-controlled: not read)\n' "$mark" "$name"
    continue
  fi
  json=$(read_tegami --session "$name" --json 2>/dev/null) || { printf '%s %-22s  no record\n' "$mark" "$name"; continue; }
  printf '%s' "$json" | python3 -c '
import json, sys
name = sys.argv[1]; mark = sys.argv[2]
try:
    d = json.load(sys.stdin)
except Exception:
    print(f"{mark} {name:<22}  no record"); sys.exit(0)
obj = (d.get("objective") or "").strip() or "(no objective)"
ladder = d.get("ladder") or []
at = d.get("at") or {}
now = ""
def rungs():
    for i, r in enumerate(ladder, 1):
        yield f"{i}", r.get("gate") or r.get("title") or "", r.get("status") or ""
        for j, l in enumerate(r.get("legs") or [], 1):
            yield f"{i}.{j}", l.get("title") or l.get("leg") or "", l.get("status") or ""
if isinstance(at, dict) and at.get("rung"):
    key = f"{at['rung']}" + (f".{at['leg']}" if at.get("leg") else "")
    for k, t, s in rungs():
        if k == key: now = f"at {k} {t} [{s}]"; break
if not now:
    for k, t, s in rungs():
        if s.upper() == "ACTIVE": now = f"at {k} {t} [ACTIVE]"; break
done = sum(1 for _, _, s in rungs() if s.upper() == "DONE")
total = sum(1 for _ in rungs())
print(f"{mark} {name:<22}  {obj}")
print(f"     {now or 'no rung active'}  ·  {done}/{total} rungs done")
' "$name" "$mark"
done <<< "$roster"
